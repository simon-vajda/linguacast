---
import { ChevronLeft, ChevronRight, X } from '@lucide/astro';
---

<dialog class="lightbox" aria-label="Screenshot" tabindex="-1" data-lightbox-dialog>
  <img class="image" alt="" data-lightbox-image />
  <button
    type="button"
    class="control close hover-overlay-strong focus-halo"
    aria-label="Close"
    data-lightbox-close
  >
    <X class="icon" />
  </button>
  <button
    type="button"
    class="control step previous hover-overlay-strong focus-halo"
    aria-label="Previous screenshot"
    data-lightbox-step="-1"
  >
    <ChevronLeft class="icon" />
  </button>
  <button
    type="button"
    class="control step next hover-overlay-strong focus-halo"
    aria-label="Next screenshot"
    data-lightbox-step="1"
  >
    <ChevronRight class="icon" />
  </button>
</dialog>

<script>
  const dialog = document.querySelector<HTMLDialogElement>('[data-lightbox-dialog]');
  const image = dialog?.querySelector<HTMLImageElement>('[data-lightbox-image]');

  if (dialog && image) {
    let links: HTMLAnchorElement[] = [];
    let index = 0;

    const show = (next: number) => {
      index = (next + links.length) % links.length;
      const link = links[index];
      const thumbnail = link.querySelector('img');
      image.src = link.href;
      image.alt = thumbnail?.alt ?? '';
      image.width = Number(link.dataset.width);
      image.height = Number(link.dataset.height);
      dialog.dataset.single = String(links.length < 2);
    };

    document.querySelectorAll<HTMLAnchorElement>('[data-lightbox]').forEach((link) => {
      link.addEventListener('click', (event) => {
        if (event.metaKey || event.ctrlKey || event.shiftKey || event.button !== 0) {
          return;
        }
        event.preventDefault();
        links = [
          ...document.querySelectorAll<HTMLAnchorElement>(
            `[data-lightbox="${link.dataset.lightbox}"]`,
          ),
        ];
        show(links.indexOf(link));
        dialog.showModal();
        dialog.focus();
      });
    });

    dialog.querySelectorAll<HTMLButtonElement>('[data-lightbox-step]').forEach((button) => {
      button.addEventListener('click', () => show(index + Number(button.dataset.lightboxStep)));
    });

    dialog.querySelector('[data-lightbox-close]')?.addEventListener('click', () => dialog.close());

    dialog.addEventListener('click', (event) => {
      if (event.target === dialog) {
        dialog.close();
      }
    });

    dialog.addEventListener('keydown', (event) => {
      if (event.key === 'ArrowLeft') {
        show(index - 1);
      } else if (event.key === 'ArrowRight') {
        show(index + 1);
      }
    });

    dialog.addEventListener('close', () => {
      image.removeAttribute('src');
      links[index]?.focus();
    });
  }
</script>

<style>
  .lightbox {
    outline: none;
    width: 100%;
    height: 100%;
    max-width: none;
    max-height: none;
    margin: 0;
    padding: var(--space-16) var(--gutter);
    border: none;
    background: transparent;
    color: var(--foreground);
  }

  .lightbox[open] {
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .lightbox::backdrop {
    background: var(--lightbox-backdrop);
    backdrop-filter: blur(var(--space-1));
  }

  .image {
    display: block;
    max-width: 100%;
    max-height: 100%;
    width: auto;
    height: auto;
    object-fit: contain;
    border-radius: var(--radius-md);
    box-shadow: 0 0 0 1px var(--lightbox-edge);
    background: var(--card);
  }

  .control {
    position: absolute;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: var(--size-touch);
    height: var(--size-touch);
    padding: 0;
    border: 1px solid transparent;
    border-radius: var(--radius-full);
    background-color: var(--secondary);
    color: var(--foreground);
    cursor: pointer;
  }

  .close {
    top: var(--space-3);
    right: var(--space-3);
  }

  .step {
    bottom: var(--space-3);
  }

  .previous {
    left: calc(50% - var(--size-touch) - var(--space-2));
  }

  .next {
    left: calc(50% + var(--space-2));
  }

  .lightbox[data-single='true'] .step {
    display: none;
  }

  .icon {
    width: var(--size-icon-lg);
    height: var(--size-icon-lg);
  }

  :global(html:has(.lightbox[open])) {
    overflow: hidden;
  }
</style>
