---
import { Image } from 'astro:assets';
import appStore from '../../assets/stores/app-store.svg';
import googlePlay from '../../assets/stores/google-play.png';

interface Props {
  note?: string;
}

const { note } = Astro.props;
---

<div class="store-badges">
  <div class="status">
    {note && <span class="note">{note}</span>}
    <span class="soon">Coming soon</span>
  </div>
  <div class="badges" title="Coming soon">
    <Image src={appStore} alt="Download on the App Store — coming soon" class="badge" />
    <Image src={googlePlay} alt="Get it on Google Play — coming soon" class="badge" />
  </div>
</div>

<style>
  .store-badges {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .status {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    flex-wrap: wrap;
  }

  .note {
    font-size: var(--text-note);
    color: var(--muted-foreground);
  }

  .soon {
    display: inline-flex;
    align-items: center;
    height: var(--size-badge);
    padding: var(--space-0-5) var(--space-2);
    border: 1px dashed var(--border);
    border-radius: var(--radius-4xl);
    font-size: var(--text-meta);
    font-weight: 500;
    white-space: nowrap;
  }

  .badges {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    flex-wrap: wrap;
    cursor: default;
    user-select: none;
  }

  .badge {
    display: block;
    width: auto;
    height: var(--size-store-badge);
  }
</style>
