---
import { Image } from 'astro:assets';
import logoMark from '../../assets/logo-mark.svg';
import ButtonLink from './ButtonLink.astro';
import { githubHref, installationHref } from './links';
import ThemeToggle from './ThemeToggle.astro';
---

<header class="header">
  <div class="inner">
    <a href="/" class="brand focus-outline">
      <Image src={logoMark} alt="" class="logo" />
      <span class="name">Hallspeak</span>
    </a>
    <nav class="nav" aria-label="Main">
      <ButtonLink href={installationHref} variant="ghost" class="wide-only">Docs</ButtonLink>
      <ButtonLink href={githubHref} variant="ghost" class="wide-only">GitHub</ButtonLink>
      <ThemeToggle />
      <ButtonLink href={installationHref}>Get started</ButtonLink>
    </nav>
  </div>
</header>

<style>
  .header {
    border-bottom: 1px solid var(--border);
  }

  .inner {
    max-width: var(--shell);
    margin: 0 auto;
    padding: var(--space-4) var(--gutter);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-6);
    flex-wrap: wrap;
  }

  .brand {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    border-radius: var(--radius-sm);
  }

  .logo {
    display: block;
    width: auto;
    height: var(--size-logo);
  }

  .name {
    font-size: var(--text-section);
    font-weight: 600;
    letter-spacing: var(--text-section--letter-spacing);
  }

  .nav {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    flex-wrap: wrap;
  }

  .nav :global(.wide-only) {
    display: none;
  }

  @media (min-width: 40rem) {
    .nav :global(.wide-only) {
      display: inline-flex;
    }
  }
</style>
