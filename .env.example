# Copy this file to .env next to compose.yaml, fill in PUBLIC_ADDRESS, and run
# `docker compose up -d`. Guide: https://hallspeak.app/getting-started/installation/
#
# Uncommented lines are yours to decide. Every commented-out line shows the default the
# server uses when it is absent; uncomment one only to change it.

# ---------------------------------------------------------------------------------------
# Required
# ---------------------------------------------------------------------------------------

# Where guests reach this server for audio: your public hostname, usually the one your
# reverse proxy serves (e.g. hallspeak.example.com), or your public IP address if you have
# no hostname. Audio does not go through the proxy — it connects here directly on the RTC
# ports. A wrong value gives a deployment where every screen loads and no audio arrives,
# with no error anywhere.
PUBLIC_ADDRESS=

# ---------------------------------------------------------------------------------------
# Recommended
# ---------------------------------------------------------------------------------------

# Comma-separated addresses your reverse proxy reaches the container from; only these may
# set X-Forwarded-For. Empty (the default) believes nobody, which behind a proxy puts every
# visitor into one sign-in throttle bucket. Usually not the proxy's LAN address — see
# https://hallspeak.app/getting-started/hosting/#trusted_proxy_ips
TRUSTED_PROXY_IPS=

# ---------------------------------------------------------------------------------------
# Compose (read by compose.yaml, not by the server)
# ---------------------------------------------------------------------------------------

# The image tag to run. To upgrade: change it, then `docker compose pull` and
# `docker compose up -d`. `latest` takes every release as it lands.
HALLSPEAK_VERSION=0.15.0

# Host directory mounted as /data: the database, admin.json and the retained logs — all
# of your state. Relative paths resolve against the directory holding compose.yaml.
HALLSPEAK_DATA_DIR=./data

# ---------------------------------------------------------------------------------------
# Optional
# ---------------------------------------------------------------------------------------

# How many CPU cores Hallspeak may use, which is how many events can run in parallel. One
# event always runs on one core, so this never raises the audience of a single event.
# Capped by the host's core count. Each core in use needs one RTC port: raising this means
# extending the port ranges in compose.yaml and your router forwarding by hand.
#MEDIA_MAX_WORKERS=4

# The first RTC port. Worker i binds MEDIA_RTC_PORT_BASE + i on UDP and TCP. Changing it
# means changing the port publications in compose.yaml and your router forwarding to match.
#MEDIA_RTC_PORT_BASE=44400

# STUN server that helps guests behind a restrictive NAT, and that the startup check asks
# for a second opinion on your public address. Set it empty to use none — a STUN server
# learns that a guest connected here.
#MEDIA_STUN_URL=stun:stun.l.google.com:19302

# The uid/gid the server runs as and the owner given to the data directory. Set these to
# your own to read the database from the host.
#PUID=1000
#PGID=1000

# error, warn, info, debug or trace. debug adds per-connection ICE and DTLS detail; trace
# adds listeners' network addresses, on screen and in the retained log. Raise it only while
# reproducing a problem, and read the output before you share it.
#LOG_LEVEL=info

# Where the retained log copy is written inside the container: one JSON object per line,
# a new file each day, 14 files kept. Set it empty to write none.
#LOG_DIR=/data/logs

# The on-screen log is coloured. Set this to any value to print it plain, for instance when
# saving `docker compose logs` to a file. The retained copy in LOG_DIR is never coloured.
#NO_COLOR=1

# How long, in milliseconds, an event's media room survives with nobody on it. Shorter
# renegotiates every guest across a gap between broadcasts.
#MEDIA_ROOM_IDLE_GRACE_MS=60000

# ---------------------------------------------------------------------------------------
# Container internals — change the mount or the port publication instead
# ---------------------------------------------------------------------------------------

# HTTP port inside the container.
#PORT=3000

# Where hallspeak.db and admin.json live inside the container.
#DATA_DIR=/data

# What the RTC ports bind to inside the container.
#MEDIA_LISTEN_IP=0.0.0.0
